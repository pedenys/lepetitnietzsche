---
import Layout from '@layouts/Layout.astro';
import PageTitle from '@components/PageTitle.astro';
import Quote from '@components/Quote.astro';
import strings from '@resources/strings';
import { fetchAllPrejudices } from '@services/prismic';
import { asText } from '@prismicio/client';

const prejudices = await fetchAllPrejudices();
---

<Layout title="Le petit Nietzsche">
  <PageTitle subTitle={strings.howto} />
  {
    prejudices.map((prejudice) => (
      <Quote
        title={asText(prejudice.data.title)}
        quote={asText(prejudice.data.prejudice)}
        explanations={prejudice.data.explanation}
      />
    ))
  }
</Layout>
