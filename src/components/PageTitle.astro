---
interface Props {
  title?: string | string[];
  subTitle?: string | string[];
}

const { title, subTitle } = Astro.props;

// Helper function to render content - can be string or array
const renderContent = (arg: string | string[] | undefined) => {
  if (!arg) return null;
  if (typeof arg === 'string') {
    return [arg];
  }
  return Array.isArray(arg) ? arg : Object.values(arg);
};

const content = renderContent(title || subTitle);
const hasTitle = !!title;
const hasSubTitle = !!subTitle;
---

<div class="page-title-container">
  <div class:list={['page-title-inner', { 'has-subtitle': hasSubTitle, 'has-title': hasTitle }]}>
    {content && content.map((text) => <p>{text}</p>)}
  </div>
</div>

<style>
  .page-title-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-content: center;
    margin-bottom: 4rem;
  }

  .page-title-inner {
    background-color: var(--color-white);
    border: var(--border-wide);
    min-width: 100%;
    max-width: 100%;
    width: 80%;
    padding: 1rem 0;
  }

  .page-title-inner.has-subtitle {
    background-color: var(--color-gray);
    min-width: 40%;
  }

  .page-title-inner.has-title {
    background-color: var(--color-white);
    width: 100%;
  }

  .page-title-inner p {
    font-family: 'Eczar', serif;
    text-align: center;
    font-size: 1.6rem;
    margin: 0.3rem;
    color: var(--color-blue);
    font-weight: 200;
    line-height: 3rem;
  }

  .page-title-inner.has-title p {
    font-size: 2.6rem;
    margin: 0;
    font-weight: 500;
  }

  .page-title-inner.has-subtitle p {
    font-size: 1.6rem;
    margin: 0.3rem;
  }

  @media screen and (max-width: 600px) {
    .page-title-inner {
      min-width: 100%;
      width: 100%;
    }

    .page-title-inner p {
      font-size: 1.6rem;
      line-height: 1;
      padding: 1rem 0;
    }
  }
</style>
