{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@pages/*": ["src/pages/*"],
      "@ui/*": ["src/components/UI/*"],
      "@services/*": ["src/services/*"],
      "@styles/*": ["src/styles/*"],
      "@resources/*": ["src/resources/*"]
    },
    "strictNullChecks": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
